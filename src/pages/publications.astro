---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { profile, publications, papers } from "@/data/profile";
---

<Layout
  title="저술·논문"
  description={`${profile.name}이 집필한 지역사·문화 저술과 발표 논문 목록.`}
>
  <div class="container-page" data-pagefind-body>
    <PageHeader
      eyebrow="Publications"
      title="저술 · 논문"
      description="용인과 경기 지역의 역사·문화를 기록한 저술과, 향토사·문화정책 분야에서 발표한 논문입니다."
    />

    {
      publications.map((group) => (
        <section class="mb-14">
          <h2 class="section-title">{group.category}</h2>
          <ul class="divide-y divide-border">
            {group.items.map((item) => (
              <li class="flex gap-3 py-3.5">
                <span class="text-border select-none">—</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="mb-14">
      <h2 class="section-title">논문</h2>
      <ol class="divide-y divide-border">
        {
          papers.map((paper, i) => (
            <li class="flex gap-4 py-3.5">
              <span class="w-6 shrink-0 text-sm text-muted tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="leading-relaxed">「{paper}」</span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm text-muted">
        이 밖에 다수의 연구·기고가 있습니다.
      </p>
    </section>
  </div>
</Layout>
