---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="페이지를 찾을 수 없습니다" noindex>
  <div class="container-page py-20 text-center">
    <p class="font-serif text-6xl text-muted">404</p>
    <h1 class="mt-4 text-2xl font-bold sm:text-3xl">
      찾으시는 페이지가 없습니다
    </h1>
    <p class="mt-3 text-sm leading-relaxed text-muted">
      주소가 바뀌었거나 삭제된 페이지일 수 있습니다.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="pill">홈으로</a>
      <a href="/history/" class="pill">오늘의 역사</a>
      <a href="/search/" class="pill">검색</a>
    </div>
  </div>
</Layout>
