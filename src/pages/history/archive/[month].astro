---
import type { GetStaticPaths } from "astro";

import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Calendar from "@/components/Calendar.astro";
import HistoryList from "@/components/HistoryList.astro";
import {
  getHistoryItems,
  toDateMap,
  groupByMonth,
  monthKeyOf,
  type HistoryItem,
} from "@/utils/history";
import { todayInSeoul, formatKoreanMonth, monthRange } from "@/utils/date";

export const getStaticPaths = (async () => {
  const items = await getHistoryItems();
  const today = todayInSeoul();
  const currentMonth = today.slice(0, 7);

  const monthKeys = items.map((item) => monthKeyOf(item.date));
  const from = monthKeys.length ? [...monthKeys].sort()[0]! : currentMonth;
  const to = [currentMonth, ...monthKeys].sort().at(-1)!;

  const months = monthRange(from, to);
  const byMonth = groupByMonth(items);

  return months.map((month) => ({
    params: { month },
    props: {
      entries: (byMonth.get(month) ?? []).slice().reverse(),
      allEntries: items,
      availableMonths: months,
      today,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entries: HistoryItem[];
  allEntries: HistoryItem[];
  availableMonths: string[];
  today: string;
}

const { month } = Astro.params;
const { entries, allEntries, availableMonths, today } = Astro.props;

const entryMap = toDateMap(allEntries);
const label = formatKoreanMonth(month!);
---

<Layout
  title={`오늘의 역사 — ${label}`}
  description={`${label}에 기록한 '오늘의 역사' ${entries.length}편.`}
>
  <div class="container-page" data-pagefind-body>
    <PageHeader
      eyebrow="Today in History"
      title={label}
      description={entries.length > 0
        ? `${label}에 남긴 기록 ${entries.length}편입니다. 날짜를 눌러 읽어 보세요.`
        : `${label}에는 아직 기록이 없습니다.`}
    />

    <Calendar
      monthKey={month!}
      entryMap={entryMap}
      availableMonths={availableMonths}
      today={today}
    />

    <section class="mt-14">
      <h2 class="section-title">{label}의 기록</h2>
      <HistoryList
        entries={entries}
        emptyMessage={`${label}에는 아직 등록된 기록이 없습니다.`}
      />
    </section>

    <p class="mt-12">
      <a href="/history/" class="link-underline text-sm text-accent">
        오늘의 역사 전체 보기 →
      </a>
    </p>
  </div>
</Layout>
