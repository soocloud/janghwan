---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import {
  getHistoryItems,
  historyPath,
  monthPath,
  monthKeyOf,
  type HistoryItem,
} from "@/utils/history";
import { formatKoreanDate } from "@/utils/date";

export const getStaticPaths = (async () => {
  const items = await getHistoryItems();
  // 최신순 정렬이므로 index+1 이 '이전 날', index-1 이 '다음 날' 입니다.
  return items.map((item, index) => ({
    params: { date: item.date },
    props: {
      item,
      olderItem: items[index + 1] ?? null,
      newerItem: items[index - 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  item: HistoryItem;
  olderItem: HistoryItem | null;
  newerItem: HistoryItem | null;
}

const { item, olderItem, newerItem } = Astro.props;
const Content = item.entry ? (await render(item.entry)).Content : null;

const monthKey = monthKeyOf(item.date);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const description =
  item.summary ?? `${formatKoreanDate(item.date, false)} — ${item.title}`;
---

<Layout
  title={item.title}
  description={description}
  ogType="article"
  publishedAt={`${item.date}T00:00:00+09:00`}
  ogImage={item.image?.src}
>
  <article class="container-page" data-pagefind-body>
    <nav class="no-print mb-8 text-sm">
      <a
        href={monthPath(monthKey)}
        class="text-muted transition-colors hover:text-accent"
      >
        ← 달력으로 돌아가기
      </a>
    </nav>

    <header class="mb-10 border-b border-border pb-8">
      <p class="section-label mb-2">오늘의 역사</p>
      <time datetime={item.date} class="block font-serif text-lg text-accent">
        {formatKoreanDate(item.date)}
      </time>
      <h1 class="mt-2 text-3xl leading-tight font-bold sm:text-4xl">
        {item.title}
      </h1>
      {
        item.summary && (
          <p class="mt-4 leading-relaxed text-muted">{item.summary}</p>
        )
      }
    </header>

    {
      item.images.length > 0 && (
        <div class="mb-10 space-y-8">
          {item.images.map((image, index) => (
            <figure>
              <Image
                src={image}
                alt={
                  item.images.length > 1
                    ? `${item.imageAlt ?? item.title} (${index + 1}/${item.images.length})`
                    : (item.imageAlt ?? item.title)
                }
                widths={[480, 720, 1080]}
                sizes="(max-width: 768px) 100vw, 720px"
                loading={index === 0 ? "eager" : "lazy"}
                class="mx-auto w-full rounded-lg border border-border shadow-sm"
              />
              <figcaption class="no-print mt-3 text-center text-xs text-muted">
                {item.images.length > 1 && (
                  <span class="mr-2">
                    {index + 1} / {item.images.length}
                  </span>
                )}
                <a
                  href={image.src}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline"
                >
                  원본 이미지 보기
                </a>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }

    {
      Content && (
        <div class="prose-hanmun">
          <Content />
        </div>
      )
    }

    {
      item.tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {item.tags.map((tag) => (
            <li class="pill cursor-default text-xs">#{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="mt-10 border-t border-border pt-8">
      <ShareButtons title={item.title} url={canonical} />
    </div>

    <nav
      class="no-print mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-2"
      aria-label="이전/다음 기록"
    >
      {
        olderItem ? (
          <a
            href={historyPath(olderItem)}
            class="card group px-5 py-4 transition-colors hover:border-accent"
          >
            <p class="text-xs text-muted">← 이전 기록</p>
            <p class="mt-1 font-medium transition-colors group-hover:text-accent">
              {olderItem.title}
            </p>
          </a>
        ) : (
          <span />
        )
      }
      {
        newerItem && (
          <a
            href={historyPath(newerItem)}
            class="card group px-5 py-4 text-right transition-colors hover:border-accent sm:col-start-2"
          >
            <p class="text-xs text-muted">다음 기록 →</p>
            <p class="mt-1 font-medium transition-colors group-hover:text-accent">
              {newerItem.title}
            </p>
          </a>
        )
      }
    </nav>
  </article>
</Layout>
