---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Timeline from "@/components/Timeline.astro";
import { profile, teaching, currentPositions } from "@/data/profile";

const topics = [
  "용인학 · 지역학",
  "향토사 · 마을지",
  "전통문화 · 민속",
  "문화유산 정책",
  "스토리텔링 · 지역축제",
  "국악 · 음악사",
];
---

<Layout
  title="강의·활동"
  description={`${profile.name}의 대학·박물관·지자체 강의 이력과 위원회 활동. 특강·연수 문의를 받습니다.`}
>
  <div class="container-page" data-pagefind-body>
    <PageHeader
      eyebrow="Lectures"
      title="강의 · 활동"
      description="대학과 박물관, 지방자치단체와 도서관에서 지역학과 전통문화를 강의합니다."
    />

    <section class="mb-14">
      <h2 class="section-label">주요 강의 주제</h2>
      <ul class="flex flex-wrap gap-2">
        {topics.map((topic) => <li class="pill cursor-default">{topic}</li>)}
      </ul>
    </section>

    <section class="mb-14">
      <h2 class="section-title">강의 이력</h2>
      <Timeline
        items={teaching.map((item) => ({
          period: item.period,
          primary: item.course,
          secondary: item.org,
        }))}
      />
    </section>

    <section class="mb-14">
      <h2 class="section-title">위원회 · 학회 활동</h2>
      <Timeline
        items={currentPositions.map((item) => ({
          period: item.period,
          primary: item.org,
          secondary: item.title,
        }))}
      />
    </section>

    <section class="card px-6 py-8">
      <h2 class="mb-2 text-xl font-bold">강의를 요청하시나요?</h2>
      <p class="text-sm leading-relaxed text-muted">
        학교·기관·단체의 특강 및 연수 문의는 이메일로 보내 주세요. 주제와 대상,
        일정에 맞추어 구성해 드립니다.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={`mailto:${profile.email}`} class="pill">{profile.email}</a>
      </div>
    </section>
  </div>
</Layout>
