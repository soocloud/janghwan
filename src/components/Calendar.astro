---
import type { HistoryItem } from "@/utils/history";
import { historyPath, monthPath } from "@/utils/history";
import {
  WEEKDAYS_KO,
  daysInMonth,
  firstWeekdayOfMonth,
  formatKoreanMonth,
  shiftMonth,
  toISODate,
} from "@/utils/date";

interface Props {
  /** 'YYYY-MM' */
  monthKey: string;
  /** 'YYYY-MM-DD' -> 기록 */
  entryMap: Map<string, HistoryItem>;
  /** 이동 가능한 월 목록 ('YYYY-MM') */
  availableMonths: string[];
  /** 오늘 (한국 기준) */
  today: string;
  /** 달력 제목을 오늘의 역사 목록으로 링크할지 */
  titleHref?: string;
}

const { monthKey, entryMap, availableMonths, today, titleHref } = Astro.props;

const [year, month] = monthKey.split("-").map(Number);
const total = daysInMonth(year!, month!);
const leading = firstWeekdayOfMonth(year!, month!);

const cells: (number | null)[] = [
  ...Array.from({ length: leading }, () => null),
  ...Array.from({ length: total }, (_, i) => i + 1),
];
while (cells.length % 7 !== 0) cells.push(null);

const prev = shiftMonth(monthKey, -1);
const next = shiftMonth(monthKey, 1);
const hasPrev = availableMonths.includes(prev);
const hasNext = availableMonths.includes(next);

const countThisMonth = Array.from(entryMap.keys()).filter((d) =>
  d.startsWith(monthKey),
).length;
---

<section
  class="card overflow-hidden"
  aria-label={`${formatKoreanMonth(monthKey)} 오늘의 역사 달력`}
>
  <header
    class="flex items-center justify-between border-b border-border px-4 py-3.5 sm:px-5"
  >
    <a
      href={hasPrev ? monthPath(prev) : undefined}
      aria-disabled={!hasPrev}
      aria-label="이전 달"
      class:list={[
        "rounded-md p-2 transition-colors",
        hasPrev
          ? "text-muted hover:bg-accent-soft hover:text-accent"
          : "pointer-events-none text-border",
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </a>

    <h2 class="text-center">
      {
        titleHref ? (
          <a
            href={titleHref}
            class="font-serif text-lg font-bold transition-colors hover:text-accent sm:text-xl"
          >
            {formatKoreanMonth(monthKey)}
          </a>
        ) : (
          <span class="font-serif text-lg font-bold sm:text-xl">
            {formatKoreanMonth(monthKey)}
          </span>
        )
      }
      <span class="block text-xs font-normal text-muted">
        {countThisMonth > 0 ? `${countThisMonth}편의 기록` : "기록 준비 중"}
      </span>
    </h2>

    <a
      href={hasNext ? monthPath(next) : undefined}
      aria-disabled={!hasNext}
      aria-label="다음 달"
      class:list={[
        "rounded-md p-2 transition-colors",
        hasNext
          ? "text-muted hover:bg-accent-soft hover:text-accent"
          : "pointer-events-none text-border",
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </a>
  </header>

  <div class="p-2 sm:p-3">
    <div class="grid grid-cols-7 gap-1 pb-1" aria-hidden="true">
      {
        WEEKDAYS_KO.map((day, i) => (
          <div
            class:list={[
              "py-2 text-center text-xs font-semibold",
              i === 0 ? "text-sun" : i === 6 ? "text-sat" : "text-muted",
            ]}
          >
            {day}
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-7 gap-1">
      {
        cells.map((day, i) => {
          if (day === null) return <div class="h-14 sm:h-16" />;

          const iso = toISODate(new Date(Date.UTC(year!, month! - 1, day)));
          const entry = entryMap.get(iso);
          const weekday = i % 7;
          const isToday = iso === today;

          const numberColor =
            weekday === 0 ? "text-sun" : weekday === 6 ? "text-sat" : "";

          if (!entry) {
            return (
              <div
                class:list={[
                  "flex h-14 flex-col items-center justify-center rounded-md text-sm opacity-60 sm:h-16",
                  isToday ? "ring-1 ring-border" : "",
                  numberColor || "text-muted",
                ]}
              >
                <span>{day}</span>
              </div>
            );
          }

          return (
            <a
              href={historyPath(entry)}
              title={entry.title}
              aria-label={`${month}월 ${day}일 — ${entry.title}`}
              class:list={[
                "group flex h-14 flex-col items-center justify-center rounded-md bg-accent-soft text-sm font-semibold transition-colors hover:bg-accent sm:h-16",
                isToday ? "ring-2 ring-accent" : "",
              ]}
            >
              <span class:list={["group-hover:text-white", numberColor]}>
                {day}
              </span>
              <span class="mt-1 h-1 w-1 rounded-full bg-accent group-hover:bg-white" />
            </a>
          );
        })
      }
    </div>
  </div>

  <footer
    class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-border px-4 py-3 text-xs text-muted sm:px-5"
  >
    <span class="flex items-center gap-1.5">
      <span
        class="inline-block h-3 w-3 rounded-sm border border-border bg-accent-soft"
      ></span>
      기록이 있는 날 — 눌러서 읽기
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-3 w-3 rounded-sm ring-2 ring-accent"></span>
      오늘
    </span>
  </footer>
</section>
