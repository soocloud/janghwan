---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="mb-12 border-b border-border pb-8">
  {eyebrow && <p class="section-label">{eyebrow}</p>}
  <h1 class="text-3xl font-bold sm:text-4xl">{title}</h1>
  {
    description && (
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">
        {description}
      </p>
    )
  }
</header>
